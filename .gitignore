android/
ios/

# Local APK artifacts are attached to GitHub Releases, not committed
releases/android/*.apk

# Local audit dumps and tmp work
audit-downloads/
tmp/

# RNA-seq reference import raw/generated data — too large for git (488MB+ Reactome dumps); rebuild via scripts/
reference-imports/

# Build artifacts (safety net oltre android/ ios/)
*.apk
*.aab
local.properties
.gradle/
build/
.cxx/

# Metro / bundler cache
.metro-cache/
node_modules/.cache/

# Harness tsc outDir (compactorHarness / retrieverHarness)
scripts/.build/

# Expo extras
.expo-shared/
.expo/types/

# npm/yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Altri materiali di firma
*.p12
*.pfx

# Agent/tool scratchpads
.grok/
.scratchpad/
scripts/.build/

# CI capture output (screenshots, ui dumps, seeds)
e2e-out/
scripts/.build*/

# Local benchmark output (grader/aggregator scratch)
bench-out/

# Campaign evidence and other local run output
out/

# Coder scratch: backups next to the file they copy. Committed once by a
# `git add -A` (2026-08-15); do not let it happen again.
*.bak
*.bak2
# Device run output is scratch by default: these directories were ignored one at
# a time, so every new harness created one that was NOT ignored (2026-09-18:
# device-decode-lineup-out/). A fatal capture writes a screenshot of the app
# (scripts/ci-lib.sh:38), so an untracked one plus any `git add -A` commits what
# was on screen. Ignore the class; name the exceptions.
*-out/
# ... except the five that hold committed campaign evidence (277 files today).
# Without these the tracked files stay tracked, but a new evidence file added
# next to them would be ignored in silence, which is the failure this rule is
# supposed to prevent, not cause.
!device-counts-out/
!device-ngram-spec-out/
!device-s23-out/
!device-sweep-pilot-out/
!device-v3-out/

# Quality bake-off raw completions — regenerated by scripts/quality/run.mjs
results/quality/

# CisWire campaign captures: .messages.json / .share_hist.json hold REAL chat
# transcripts pulled off the phone, user text and all. Never publish them.
results/ciswire-campaign/

# Local Expo modules ship their native sources (the blanket android/ rule above must not swallow them)
!modules/*/android/
!modules/*/android/**

# kalsa-moe-experiments is a SEPARATE repo (Aspis0/kalsa-moe-experiments), cloned at
# ../kalsa-moe-experiments. Its PLAN.md and docs/ALIVE.md are the two living docs.
# A copy of them grew here on 15/09 and diverged for two days; do not track it again.
kalsa-moe-experiments/
