/*-out/

# Coder scratch: backups next to the file they copy. Committed once by a
# `git add -A` (2026-08-15); do not let it happen again.
*.bak
*.bak2

# Quality bake-off raw completions — regenerated by scripts/bench/quality/run.mjs
results/quality/
