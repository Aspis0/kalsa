# Modelli e file enormi — mai in git
*.gguf
*.safetensors
models/
.cache/
hf_cache/

# Python
__pycache__/
*.pyc
.venv/

# Build llama.cpp / fork (si clona a parte, non dentro questo repo)
llama.cpp/
# BigMoeOnEdge/ — ora e un SUBMODULE (Aspis0/kalsa-engine), non piu ignorato:
# cosi ogni commit di risultati registra il commit esatto dell engine che li ha prodotti.
build/
build-*/

# Rumore
*.tmp
.DS_Store
Thumbs.db

# Stato interno pi (goal state)
.pi/
results/**/bin/llama-*
results/**/bin/*.so
results/**/bin/test-backend-ops
results/**/bin/bmoe-cli*
results/**/bin/*.dll
results/**/bin/*.exe
results/ttft_verify_jelly/_bundle_fixed/

*.apk

# 20 GB of staged model artefacts — never versioned, and one `git add -A` away
# from being committed by accident. models/ was already ignored; this was not.
models_staging/

# Build turds that landed in the repo root
embed.obj
NUL

upstream-hexagon/
scratchpad/agents/q28-hexagon-sdk/downloads/
deps/hexagon/
deps/cmake/
worktree-mali-probe/
scratchpad/agents/q66-app-lifecycle-s23/app-build/
scratchpad/agents/q66-app-lifecycle-s23/llama.rn-src/

# KLD baseline logit dumps: 434 MB each, regenerable on device, never useful in git
scratchpad/agents/*/raw/*/*.kld

# Device-run evidence: keep the reports (.md), the records (.json) and the harness (.sh),
# ignore the raw dumps. 1810 logcat/uiautomator/screenshot files under scratchpad/agents were
# 195 MB against 1.8 MB of conclusions; the pack is already 530 MiB.
scratchpad/agents/**/*.txt
scratchpad/agents/**/*.xml
scratchpad/agents/**/*.png
scratchpad/agents/**/*.log
scratchpad/agents/**/*.err
scratchpad/agents/**/*.stdout
scratchpad/agents/**/*.pid
scratchpad/agents/**/*.tools
scratchpad/agents/**/*.exit
scratchpad/agents/**/*.done
scratchpad/agents/**/*.out
scratchpad/agents/**/*.meta

# RKStorage-docs are SQLite pulls of the app's AsyncStorage: they contain real chat
# transcripts, so they stay out of git the same way .messages.json/.share_hist.json do.
scratchpad/agents/**/RKStorage*
scratchpad/agents/**/did-switch

# qdc-heat-per-backend: runtime recovery state (serial + pre-run screen
# timeout), rewritten every run, read only by restore.sh — never versioned
scratchpad/agents/qdc-heat-per-backend/.restore-state

# qdc-heat-per-backend: restore.sh per-step cp-chain output (append-only log,
# written on every abnormal-end recovery) — never versioned
scratchpad/agents/qdc-heat-per-backend/restore-prefs.log

# Binaries never enter the lab: record their sha256 in the report instead.
*.apk
*.aab
scratchpad/agents/s23-launch-jank/raw/session-20260927-diagnosis/logcat.txt

# Raw run output (logcats, dumps, device logs) stays on the machine that ran
# it: logcats carry the phones' own accounts and tokens. Reports cite it.
scratchpad/agents/*/raw/
*logcat*.txt
*.logcat
*.kld
*.gguf
