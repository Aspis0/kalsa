<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  launchd template for the llama-server FALLBACK only.
  Preferred runtime is mtplx on 127.0.0.1:8000 (MTPLX.app). Do not install
  this while mtplx is serving Ornith — two copies of the model will OOM.
  Do NOT install this automatically. See README.md.

  Edit the model path and user-specific /Users/... paths before loading.
  KeepAlive=true: launchd restarts llama-server if it exits. Do not enable
  while mtplx already holds the same weights.
-->
<dict>
  <key>Label</key>
  <string>com.kalsa.macbrain</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/marco/.kalsa</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>KALSA_BRAIN_MODEL</key>
    <string>/Users/marco/.kalsa/models/ornith-1.5-35b-a3b/Ornith-1.5-35B-Q4_K_M.gguf</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/llama-server</string>
    <string>--model</string>
    <string>/Users/marco/.kalsa/models/ornith-1.5-35b-a3b/Ornith-1.5-35B-Q4_K_M.gguf</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8080</string>
    <string>--ctx-size</string>
    <string>32768</string>
    <string>--threads</string>
    <string>8</string>
    <string>--n-gpu-layers</string>
    <string>all</string>
    <string>--flash-attn</string>
    <string>auto</string>
    <string>--api-key-file</string>
    <string>/Users/marco/.kalsa/api-keys</string>
    <string>--sse-ping-interval</string>
    <string>30</string>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/marco/.kalsa/macbrain.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/marco/.kalsa/macbrain.log</string>
</dict>
</plist>
