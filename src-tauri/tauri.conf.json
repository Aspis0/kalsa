{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalsa Brain",
  "version": "0.0.1",
  "identifier": "ai.kalsa.brain",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Kalsa Brain",
        "width": 520,
        "height": 320,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
