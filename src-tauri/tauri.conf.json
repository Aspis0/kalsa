{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalsa",
  "identifier": "ai.kalsa.brain",
  "build": {
    "frontendDist": "../chat/dist",
    "beforeDevCommand": "npm --prefix ../chat run dev",
    "beforeBuildCommand": "npm --prefix ../chat run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; object-src 'none'; base-uri 'self'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/Assets.car", "icons/icon.icns"]
  }
}
