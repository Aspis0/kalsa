{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalsa",
  "version": "0.0.1",
  "identifier": "ai.kalsa.brain",
  "build": {
    "frontendDist": "../chat/dist",
    "beforeDevCommand": "npm --prefix ../chat run dev",
    "beforeBuildCommand": "npm --prefix ../chat run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kalsa",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
