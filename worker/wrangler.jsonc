{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalsa-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  // The one origin every redirect_uri, Origin check and early host check is built from.
  // It is configuration, never the request Host header.
  "vars": { "SITE_ORIGIN": "https://kalsa.io" },
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    // Only these paths reach the Worker. Every other request is served straight
    // from the generated site, so the static pages keep their own caching.
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kalsa",
      // Placeholder: replace with the id printed by `npx wrangler d1 create kalsa`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "preview": {
      "name": "kalsa-site-preview",
      "compatibility_date": "2026-11-18",
      "compatibility_flags": ["nodejs_compat"],
      // Replace with this account's workers.dev subdomain before deploying preview.
      // Until then preview fails closed: no request origin matches this value, so
      // every /auth/* and /api/* request is refused rather than served on a wrong host.
      "vars": { "SITE_ORIGIN": "https://kalsa-site.REPLACE_WITH_ACCOUNT.workers.dev" },
      "assets": {
        "directory": "../site/dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/auth/*"]
      },
      // A separate database, so a preview deployment cannot read production sessions.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kalsa-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
        "traces": { "enabled": true, "head_sampling_rate": 0.01 }
      }
    }
  }
}
