{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalsa-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  // The one origin every redirect_uri, Origin check and early host check is built from.
  // It is configuration, never the request Host header.
  "vars": { "SITE_ORIGIN": "https://preview.kalsa.io" },
  "routes": [{ "pattern": "preview.kalsa.io", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    // The dynamic routes, and every answer that could name a removed engine or developer: the HTML
    // lists, engines.json, the allow-list, the badges and the sitemap. Everything else (scripts,
    // styles, the prose pages) is served straight from the generated site and keeps its own caching.
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/",
      "/index.html",
      "/engines/*",
      "/dev/*",
      "/hardware/*",
      "/badge/*",
      "/sitemap.xml",
      "/pages.json"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kalsa",
      "database_id": "9003d24b-4a2a-48a3-815e-22e3dd95f802",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
