+static bool compare_graph_backend_judge(
+        ggml_backend_t backend1,
+        ggml_backend_t backend2,
+        struct ggml_cgraph * graph,
+        ggml_backend_eval_callback callback,
+        void * user_data,
+        struct ggml_tensor const * const * test_nodes,
+        size_t num_test_nodes) {
+    const bool plain_host = ggml_test_plain_host();
+
+    if (!plain_host) {
+        // Stock compare path. Buffer-type logging happens in the eval callback on fail.
+        return ggml_backend_compare_graph_backend(backend1, backend2, graph, callback, user_data,
+                                                    test_nodes, num_test_nodes);
+    }
+
+    // graph_copy uses backend2's default buft. CPU default is already
+    // ggml_backend_cpu_buffer_type(); we recopy through get/set so a
+    // host-marked packed source cannot memcpy tiled bytes into the reference.
+    struct ggml_backend_graph_copy copy = ggml_backend_graph_copy(backend2, graph);
+    if (copy.buffer == NULL) {
+        return false;
+    }
+    recopy_via_get_set(graph, copy.graph);
+    GGML_ASSERT(ggml_backend_buffer_get_type(copy.buffer) == ggml_backend_cpu_buffer_type());
+    {
+        const char * got = ggml_backend_buffer_name(copy.buffer);
+        const char * want = ggml_backend_buft_name(ggml_backend_cpu_buffer_type());
+        std::lock_guard<std::mutex> guard(g_ref_buf_mutex);
+        fprintf(stderr, "[ref-buf] PLAIN_HOST=1 copy-buffer=\"%s\" cpu_buft=\"%s\" recopy=get/set\n",
+                got ? got : "(null)", want ? want : "(null)");
+    }
+
+    struct ggml_cgraph * g1 = graph;
+    struct ggml_cgraph * g2 = copy.graph;
+    const int n_nodes = ggml_graph_n_nodes(g1);
+    GGML_ASSERT(n_nodes == ggml_graph_n_nodes(g2));
+
+    {
+        std::lock_guard<std::mutex> guard(g_ref_buf_mutex);
+        log_graph_ref_buffers(g1, g2);
+    }
+
+    // Whole-graph compute (public API only; avoids ggml_graph_view from ggml-impl.h).
+    ggml_backend_graph_compute(backend1, g1);
+    ggml_backend_graph_compute(backend2, g2);
+
+    if (num_test_nodes != 0) {
+        GGML_ASSERT(test_nodes);
+        bool verified = false;
+        for (int i = 0; i < n_nodes; i++) {
+            for (size_t j = 0; j < num_test_nodes; ++j) {
+                if (ggml_graph_node(g1, i) == test_nodes[j]) {
+                    callback(i, ggml_graph_node(g1, i), ggml_graph_node(g2, i), user_data);
+                    verified = true;
+                }
+            }
+        }
+        GGML_ASSERT(verified);
+    } else {
+        for (int i = 0; i < n_nodes; i++) {
+            struct ggml_tensor * t1 = ggml_graph_node(g1, i);
+            struct ggml_tensor * t2 = ggml_graph_node(g2, i);
+            if (ggml_is_view_op(t1->op)) {
+                continue;
+            }
+            if (!callback(i, t1, t2, user_data)) {
+                break;
+            }
+        }
+    }
+
+    ggml_backend_graph_copy_free(copy);
+    return true;
+}
