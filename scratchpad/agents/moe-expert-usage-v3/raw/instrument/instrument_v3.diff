+    uint64_t counts[N_LAYER][N_EXPERT] = {};
+    double mass[N_LAYER][N_EXPERT] = {};
+    double wsum_total[N_LAYER] = {};  // sum of per-token top-k weight sums
+    double wsum_min[N_LAYER]   = {};
+    double wsum_max[N_LAYER]   = {};
 
