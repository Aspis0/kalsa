+static std::vector<Segment> parse_segments(const char * path) {
+    std::ifstream f(path);
+    if (!f) {
+        fprintf(stderr, "ROUTER_CALLBACK_ERROR cannot open segments file '%s'\n", path);
+        std::exit(2);
+    }
+    std::vector<Segment> out;
+    std::string line;
+    bool open = false;
+    while (std::getline(f, line)) {
+        if (line.rfind("<<<SEG ", 0) == 0) {
+            // header: <<<SEG group=NAME id=N >>>
+            Segment seg;
+            const size_t gpos = line.find("group=");
+            const size_t ipos = line.find(" id=");
+            if (gpos == std::string::npos || ipos == std::string::npos) {
+                fprintf(stderr, "ROUTER_CALLBACK_ERROR malformed segment header: %s\n", line.c_str());
+                std::exit(2);
+            }
+            seg.group = line.substr(gpos + 6, ipos - (gpos + 6));
+            const size_t end = line.find(' ', ipos + 1);
+            seg.id = line.substr(ipos + 4, end == std::string::npos ? std::string::npos : end - (ipos + 4));
+            out.push_back(std::move(seg));
+            open = true;
+        } else if (open) {
+            Segment & seg = out.back();
+            seg.text += line;
+            seg.text += '\n';
+        }
     }
+    return out;
