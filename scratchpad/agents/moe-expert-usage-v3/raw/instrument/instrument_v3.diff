+// "ffn_moe_topk-<il>": the digits must start right after the last '-', so that a
+// hypothetical non-numeric suffix ("...-mtp") is rejected instead of parsing as 0.
+static int parse_layer(const char * name) {
+    const char * dash = strrchr(name, '-');
+    if (dash == nullptr || dash[1] < '0' || dash[1] > '9') {
+        return -1;
     }
+    const int layer = atoi(dash + 1);
+    return layer < N_LAYER ? layer : -1;
+}
