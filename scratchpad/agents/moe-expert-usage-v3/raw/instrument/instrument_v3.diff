+static bool router_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    const char * name = t->name;
+    const bool topk    = strncmp(name, "ffn_moe_topk-", 13) == 0;
+    const bool weights = strncmp(name, "ffn_moe_weights-", 16) == 0 && strchr(name, ' ') == nullptr;
+    if (ask) return topk || weights;
+    if (!topk && !weights) return true;
+
+    auto * stats = static_cast<RouterStats *>(user_data);
+    const int layer = parse_layer(name);
+    if (layer < 0) router_fail("unparseable layer index", name);
 
+    if (topk) {
+        if (t->type != GGML_TYPE_I32) router_fail("top-k is not I32", name);
+        if (t->nb[0] != sizeof(int32_t)) router_fail("top-k element stride is not 4", name);
+        if (stats->pending_tokens[layer] != 0) router_fail("new top-k while weights pending", name);
+        const int64_t k    = t->ne[0];
+        const int64_t ntok = t->ne[1];
+
+        std::vector<int32_t> & ids = stats->pending_topk[layer];
+        ids.assign((size_t)(ntok * k), 0);
+        std::vector<int32_t> row((size_t)k);
+        for (int64_t tok = 0; tok < ntok; ++tok) {
+            ggml_backend_tensor_get(t, row.data(), (size_t)(tok * t->nb[1]), (size_t)(k * sizeof(int32_t)));
+            for (int64_t r = 0; r < k; ++r) {
+                const int32_t expert = row[(size_t)r];
+                if (expert < 0 || expert >= N_EXPERT) router_fail("expert id out of range", name);
+                ids[(size_t)(tok * k + r)] = expert;
+                stats->counts[layer][expert]++;
+            }
+        }
+        stats->pending_tokens[layer] = ntok;
+        stats->topk_calls[layer]++;
+        stats->tokens_seen[layer] += ntok;
+    } else {
+        if (t->type != GGML_TYPE_F32) router_fail("weights are not F32", name);
+        if (t->nb[0] != sizeof(float)) router_fail("weights element stride is not 4", name);
+        if (stats->pending_tokens[layer] == 0) router_fail("weights without pending top-k", name);
+        if (t->ne[0] != 1) router_fail("unexpected weights shape", name);
+        const int64_t k    = t->ne[1];
+        const int64_t ntok = t->ne[2];
+        if (k != (int64_t)(stats->pending_topk[layer].size() / stats->pending_tokens[layer])) {
+            router_fail("weights k does not match pending top-k", name);
+        }
+        if (ntok != stats->pending_tokens[layer]) {
+            router_fail("weights token count does not match pending top-k", name);
+        }
+
+        const bool rank_contiguous = t->nb[1] == sizeof(float);
+        std::vector<float> row((size_t)k);
+        for (int64_t tok = 0; tok < ntok; ++tok) {
+            double wsum = 0.0;
+            for (int64_t r = 0; r < k; ++r) {
+                float w = 0.0f;
+                if (rank_contiguous) {
+                    if (r == 0) {
+                        ggml_backend_tensor_get(t, row.data(), (size_t)(tok * t->nb[2]), (size_t)(k * sizeof(float)));
+                    }
+                    w = row[(size_t)r];
+                } else {
+                    ggml_backend_tensor_get(t, &w, (size_t)(tok * t->nb[2] + r * t->nb[1]), sizeof(float));
+                }
+                const int32_t expert = stats->pending_topk[layer][(size_t)(tok * k + r)];
+                if (expert < 0 || expert >= N_EXPERT) router_fail("expert id out of range", name);
+                stats->mass[layer][expert] += w;
+                wsum += w;
+            }
+            if (wsum <= 0.0 || wsum > 1.0) router_fail("top-k weight sum outside (0, 1]", name);
+            if (tok == 0 || wsum < stats->wsum_min[layer]) stats->wsum_min[layer] = wsum;
+            if (tok == 0 || wsum > stats->wsum_max[layer]) stats->wsum_max[layer] = wsum;
+            stats->wsum_total[layer] += wsum;
+        }
+        stats->pending_tokens[layer] = 0;
+        stats->weights_calls[layer]++;
+    }
     return true;
 }
 
+// appends the segment's [N_LAYER][N_EXPERT] count and mass blocks to the binary
+// streams, returns the per-layer min/mean/max of the per-token top-k weight sums
+static void flush_segment(const RouterStats & stats, std::ostream & counts_bin, std::ostream & mass_bin) {
+    for (int layer = 0; layer < N_LAYER; ++layer) {
+        for (int expert = 0; expert < N_EXPERT; ++expert) {
+            uint32_t c = (uint32_t)stats.counts[layer][expert];
+            counts_bin.write((const char *)&c, sizeof(c));
+        }
+        for (int expert = 0; expert < N_EXPERT; ++expert) {
+            float m = (float)stats.mass[layer][expert];
+            mass_bin.write((const char *)&m, sizeof(m));
+        }
+    }
+}
