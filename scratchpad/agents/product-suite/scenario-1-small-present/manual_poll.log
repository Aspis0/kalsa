09-09 08:02:54.482 I/adbd    (10663): battery_level_pct=$(printf '%s\n' "$battery_dump" | grep -m1 -E '^[[:space:]]*level:[[:space:]]*-?[0-9]+' | sed -E 's/.*level:[[:space:]]*(-?[0-9]+).*/\1/' || true)
09-09 08:02:54.482 I/adbd    (10663): battery_ac=$(printf '%s\n' "$battery_dump" | grep -m1 -E 'AC powered:' | sed -E 's/.*AC powered:[[:space:]]*//' || true)
