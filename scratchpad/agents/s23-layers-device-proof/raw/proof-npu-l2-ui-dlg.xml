se" selected="false" bounds="[237,396][258,417]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.kalsa.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[246,429][261,444]" drawing-order="3" hint="" /></node></node><node index="6" text="" resource-id="transcript.text.a-130870802" class="android.view.ViewGroup" package="com.kalsa.app" content-desc="Litio-ion cells in phones store energy by moving lithium ions between a graphite anode and a metal‑oxide cathode and work best in a narrow temperature range of fifteen to forty degrees Celsius. Heat i" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,468][1032,1728]" drawing-order="7" hint=""><node index="0" text="Litio-ion cells in phones store energy by moving lithium ions between a graphite anode and a metal‑oxide cathode and work best in a narrow temperature range of fifteen to forty degrees Celsius. Heat is the central constraint because phones have no fans and must keep the surface below about forty‑three degrees Celsius to avoid thermal throttling. A system‑on‑chip pairs high‑performance cores for matrix arithmetic with a graphics processor for parallel work and a specialized digital signal processor optimized for quantized neural network calculations. Memory bandwidth becomes the other half of the story, as the large weight tensors must be streamed from RAM to the engines, often limiting token‑by‑token speed. The dominant factor is the thermal ceiling that limits sustained on‑device inference on a passively cooled phone." resource-id="transcript.answer.a-130870802.b0.0" class="android.widget.TextView" package="com.kalsa.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,468][1032,1728]" drawing-order="1" hint="" /></node><node index="7" text="" resource-id="transcript.copy.a-130870802" class="android.widget.Button" package="com.kalsa.app" content-desc="Copia" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1746][214,1890]" drawing-order="8" hint=""><node index="0" text="" resource-id="" class="com.horcrux.svg.SvgView" package="com.kalsa.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1791][102,1845]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="com.horcrux.svg.GroupView" package="com.kalsa.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1795][97,1840]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="com.horcrux.svg.PathView" package="com.kalsa.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1795][84,1827]" drawing-order="2" hint="" /><node index="1" text="" resource-id="" class="com.horcrux.svg.RectView" package="com.kalsa.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,1809][98,1841]" drawing-order="1" hint="" /></node></node><node index="1" text=