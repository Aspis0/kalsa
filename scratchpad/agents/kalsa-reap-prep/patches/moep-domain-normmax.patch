 def load_stats(path: str | Path) -> tuple[dict, dict]:
     d = torch.load(path, map_location="cpu", weights_only=True)
     return d["stats"], d["meta"]
 
 
+def merge_stats(paths: list[str | Path]) -> tuple[dict, int]:
+    """Merge per-domain stat files into one: additive accumulators sum, norm_max takes
+    the element-wise max (an expert maximal in any domain stays maximal in the union)."""
+    merged: dict = {}
+    total = 0
+    for p in paths:
+        d, _ = load_stats(p)
+        total += int(d.pop("total_tokens"))
+        for k, v in d.items():
+            if k not in merged:
+                merged[k] = v.clone()
+            elif k in MAX_KEYS:
+                merged[k] = torch.maximum(merged[k], v)
+            else:
+                merged[k] = merged[k] + v
+    return merged, total
+
