+static bool moe_ffn_tensor_in_range(
+        const struct ggml_cgraph * cgraph,
+        int lo, int hi,
+        const struct ggml_tensor * t) {
+    for (int i = lo; i < hi; ++i) {
+        if (cgraph->nodes[i] == t) {
+            return true;
