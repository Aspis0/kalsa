+// 0/n/N/f/F and "off"/"OFF" disable (matches bmoe-cli --moe-fused-ffn off).
+static bool moe_fused_env_disabled(const char * e) {
+    if (!e || !e[0]) {
+        return false;
+    }
+    if (e[0] == '0' || e[0] == 'n' || e[0] == 'N' || e[0] == 'f' || e[0] == 'F') {
+        return true;
+    }
+    if ((e[0] == 'o' || e[0] == 'O') &&
+        (e[1] == 'f' || e[1] == 'F') &&
+        (e[2] == 'f' || e[2] == 'F') && e[3] == '\0') {
+        return true;
+    }
+    return false;
+}
