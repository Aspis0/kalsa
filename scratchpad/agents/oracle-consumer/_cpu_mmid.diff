+// VIEW of mul, or an ADD/CONT already accepted into the reduce tail.
+static bool moe_ffn_is_reduce_src(
+        const struct ggml_tensor * t,
+        const struct ggml_tensor * mul,
+        const struct ggml_cgraph * cgraph,
+        int tail_lo, int tail_hi) {
+    if (!t || !moe_ffn_tensor_in_range(cgraph, tail_lo, tail_hi, t)) {
+        return false;
+    }
+    if (t->op == GGML_OP_VIEW && t->src[0] == mul) {
+        return true;
+    }
+    return t->op == GGML_OP_ADD || t->op == GGML_OP_CONT;
+}
+
+static bool moe_ffn_span_has_external_use(
+        const struct ggml_cgraph * cgraph,
+        int first, int last) {
+    for (int i = first; i < last; ++i) {
+        const struct ggml_tensor * node = cgraph->nodes[i];
+        if (node->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return true;
+        }
+        int span_uses = 0;
+        for (int j = i + 1; j <= last; ++j) {
+            const struct ggml_tensor * other = cgraph->nodes[j];
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (other->src[s] == node) {
+                    span_uses++;
+                }
+            }
+        }
+        if (span_uses != ggml_node_get_use_count(cgraph, i)) {
+            return true;
+        }
+    }
+    return false;
+}
