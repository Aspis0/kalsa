+static int opt_no_binary = 0;   // GGML_HEXAGON_NO_BINARY=1: decline ADD/SUB/MUL/DIV (skel op_binary)
 
 static std::regex* opt_opfilter = NULL; // regex of ops to not claim
 
@@ -4087,6 +4088,12 @@ static bool ggml_backend_hexagon_device_supports_op(ggml_backend_dev_t dev, cons
         case GGML_OP_ADD:
         case GGML_OP_SUB:
         case GGML_OP_DIV:
